{
  "name": "@blockhash/mancer-sdk",
  "version": "0.2.3",
  "description": "Mancer's API for a bot with a wallet: sign in, swap, orders, sends, Books and account events, every build checked before it is signed",
  "license": "MIT",
  "author": "Blockhash",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "homepage": "https://docs.mancer.xyz/agents/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blockhash-xyz/mancer-sdk.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/blockhash-xyz/mancer-sdk/issues"
  },
  "keywords": [
    "mancer",
    "robinhood-chain",
    "dex-aggregator",
    "swap",
    "limit-orders",
    "trading-bot",
    "ai-agents",
    "viem",
    "ethereum",
    "defi"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "gen:types": "node scripts/gen-types.mjs",
    "check:types": "node scripts/gen-types.mjs --check"
  },
  "dependencies": {
    "viem": "^2.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "yaml": "^2.8.0"
  }
}
