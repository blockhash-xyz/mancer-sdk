# Copy to .env beside bot.ts and fill in BOT_PRIVATE_KEY. .env stays out of git (.gitignore).
# Use a fresh wallet that holds only what the bot may trade: the key in this file can spend all of it.
BOT_PRIVATE_KEY=

# Where the bot talks. These are the defaults: Mancer's API, Robinhood Chain's public RPC, Mancer's stream.
MANCER_API_URL=https://api.mancer.xyz
MANCER_RPC_URL=https://rpc.mainnet.chain.robinhood.com
MANCER_STREAM_URL=wss://stream.mancer.xyz/socket
# For a local stand-in of the API and the chain only: the domain its sign-in names, and a file of
# its Books deployments. Leave them empty: the SDK then signs in to Mancer's own API alone, and holds every Book to its pins.
MANCER_SIGN_IN_DOMAIN=
BOOK_DEPLOYMENTS_FILE=

# Every floor the bot signs is a Uniswap V3 pool's price on your RPC, less this many basis points: the SDK's own
# poolReference() for ETH against USDG, the best fee tier by Uniswap's QuoterV2 for any other pair.
SLIPPAGE_BPS=50
# 1 lets Mancer's own quote set a floor where no Uniswap V3 pool prices the pair. Leave it 0 unless you know why.
TRUST_QUOTE=0

# 2. The swap: SWAP_AMOUNT ETH into SWAP_TOKEN_OUT (ETH, WETH, USDG or a token's address).
SWAP_AMOUNT=0.001
SWAP_TOKEN_OUT=USDG

# 3. The limit order: LIMIT_AMOUNT of LIMIT_TOKEN_IN into LIMIT_TOKEN_OUT. 0 places none.
# It asks LIMIT_VS_MARKET_PCT over the market (50: half again what the market pays, so it rests), or LIMIT_PRICE
# (LIMIT_TOKEN_OUT per LIMIT_TOKEN_IN) where that is set. Mancer's executor fills it once the market pays the price.
LIMIT_TOKEN_IN=ETH
LIMIT_TOKEN_OUT=USDG
LIMIT_AMOUNT=0.25
LIMIT_VS_MARKET_PCT=50
LIMIT_PRICE=

# 4. The send: SEND_AMOUNT ETH to SEND_TO. Empty sends nothing.
SEND_TO=
SEND_AMOUNT=0.01

# 5. The Book trade: a Book this wallet is a trader of. Empty skips it. BOOK_SELL defaults to the Book's base pair,
# BOOK_BUY to WETH (USDG where the base pair is WETH), and BOOK_AMOUNT to 1% of what the vault holds of BOOK_SELL.
BOOK_TOKEN=
BOOK_SELL=
BOOK_BUY=
BOOK_AMOUNT=

# 6. How long to hear the account's events, in seconds. 0 listens until Ctrl-C.
LISTEN_SECONDS=0

# agent.ts: the model, the tokens it may name, and the rails it cannot change.
MODEL_PROVIDER=anthropic
MODEL=claude-opus-5-5
# Read by Anthropic's SDK. agent.ts never prints it and the model never sees it.
ANTHROPIC_API_KEY=
# MODEL_PROVIDER=stub proposes this instead, with no model asked.
STUB_PROPOSAL={"token":"USDG","side":"buy","shareBps":50,"reason":"a small test buy"}
AGENT_TOKENS=USDG=0x5fc5360d0400a0fd4f2af552add042d716f1d168,MANCER=0xc72f232a6869e6cf34dc06129affd07f8a2a246a
RAIL_MAX_TRADE_BPS=200
RAIL_DAILY_CAP_BPS=1000
RAIL_MAX_IMPACT_BPS=100
RAIL_SLIPPAGE_BPS=50
RAIL_GAS_FLOOR_ETH=0.002
# 1 signs and sends a trade that passes every rail; 0 builds, checks and simulates it, and signs nothing.
AGENT_SEND=0
AGENT_LEDGER=agent-ledger.json
