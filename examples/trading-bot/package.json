{
  "name": "mancer-trading-bot",
  "version": "0.1.0",
  "private": true,
  "description": "A Mancer bot with its own wallet: sign in, swap, a limit order, a send, a Book trade and the account's live events, with an AI agent whose trades the bot's own rails check",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bot": "tsx --env-file=.env bot.ts",
    "agent": "tsx --env-file=.env agent.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@blockhash/mancer-sdk": "^0.2.0",
    "viem": "2.55.10"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
