{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    // Beside the SDK's source (this folder inside the repository the SDK comes from), the bot runs on that source, for
    // the typecheck and for tsx alike. Copied anywhere else, the path names nothing, and the SDK installed from npm is
    // the one it runs on.
    "paths": {
      "@blockhash/mancer-sdk": ["../../packages/sdk/src/index.ts"]
    }
  },
  "include": ["*.ts", "test", "fork"]
}
